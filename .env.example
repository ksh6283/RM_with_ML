# Copy to .env and fill in (.env is git-ignored).
# Shell-compatible: no spaces around '=', so `set -a; source .env; set +a` also works.

# Node IP used to reach NodePort services (Jaeger 30095, hotel 30096, train 32677, ...)
CLUSTER_HOST=
# Prometheus URL, e.g. http://<host>:30090 (leave empty to collect traces only)
PROMETHEUS_URL=

# Kubernetes node names (kubectl get nodes), comma-separated without spaces
NODES_FOR_TEST=
NODES_FOR_INFRA=
# Node that pins the entry service via nodeName (hotel frontend, train ts-ui-dashboard)
FRONTEND_NODE=

# train-ticket entry URL for train_ticket_auto_query standalone scripts, e.g. http://<CLUSTER_HOST>:32677
TRAIN_TICKET_URL=
# train-ticket accounts (default accounts are listed in the FudanSELab/train-ticket docs)
TRAIN_TICKET_USER=
TRAIN_TICKET_PASSWORD=
TRAIN_TICKET_USER_UUID=
TRAIN_TICKET_ADMIN_USER=
TRAIN_TICKET_ADMIN_PASSWORD=
TRAIN_TICKET_EMAIL=
TRAIN_TICKET_EMAIL_PASSWORD=
# Optional pre-issued JWT / cookie for scripts that skip login
TRAIN_TICKET_TOKEN=
TRAIN_TICKET_COOKIE=

# Derm: offlineTestResult directory used by curve_cdf.py
DERM_DATA_PATH=
